# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
ADMIN_GROUP_ID=-1001234567890

# Database Configuration
# For production (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_wallet
# For development (SQLite)
SQLITE_PATH=./dev.sqlite

# Web Server Configuration
WEB_PORT=8080
WEB_JWT_SECRET=your_jwt_secret_here_change_in_production
BASE_URL=https://yourdomain.com

# Webhook Configuration (optional, uses long-polling if not set)
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/webhook

# Operational Settings (defaults - can be overridden from admin panel)
WITHDRAW_FEE_FIXED=0.10
WITHDRAW_FEE_PERCENT=2.5
DAILY_WITHDRAW_LIMIT=2
MIN_WITHDRAW_AMOUNT=0.10
MIN_TX_AMOUNT=0.01

# Referral Settings
REFERRAL_REWARD=0.25

# Calendar Settings (jalali or gregorian)
DEFAULT_CALENDAR=jalali

# Channel/Group Membership Enforcement (optional)
REQUIRE_CHANNEL_ID=

# Backup Settings
BACKUP_CRON=0 2 * * *
BACKUP_PATH=/backups

# Rate Limiting (requests per window)
RATE_LIMIT_CLAIM_REQUESTS=5
RATE_LIMIT_CLAIM_WINDOW_MS=60000
RATE_LIMIT_WITHDRAW_REQUESTS=3
RATE_LIMIT_WITHDRAW_WINDOW_MS=3600000

# Node Environment
NODE_ENV=development
